# ---------------------------------------------------------------------------
# pona flow environment configuration
#
# Copy to .env for a source checkout:   cp .env.example .env
# Docker Compose users: use .env.docker.example instead (see Docs/SELF-HOSTING.md).
#
# Real environment variables always override this file. Only the Neo4j block is
# required; everything else has a working default.
# ---------------------------------------------------------------------------

# --- Neo4j (required) ----------------------------------------------------------
# Local Neo4j Desktop / Docker: bolt://localhost:7687. Use bolt+s:// or neo4j+s:// for a
# TLS-protected remote database (Aura gives you a neo4j+s:// URI).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# --- Data directory ------------------------------------------------------------
# Where runtime state lives: the catalog data.db, per-space SQLite files, and the
# writable .env used by the "local" credential backend. Defaults to the repository root;
# the container image sets /data. Relative SQLite paths resolve under this directory.
# PONA_FLOW_DATA_DIR=./data

# Catalog SQLite file (relative to the data directory or absolute). Default: data.db
# SQLITE_DATABASE_PATH=data.db
# Name of the variable above (only change if you rename it).
# PONA_FLOW_CATALOG_SQLITE_KEY=SQLITE_DATABASE_PATH

# --- Bind address --------------------------------------------------------------
# PONA_FLOW_HOST=127.0.0.1
# PONA_FLOW_PORT=8765
# Public URL browsers use to reach this instance (behind your reverse proxy). Enables
# Secure cookies and MCP Host validation; also documented in webhook/MCP URLs.
# PONA_FLOW_PUBLIC_URL=https://flow.example.com

# --- Authentication --------------------------------------------------------------
# local (default): built-in email/password accounts. The first visit to the app shows a
#   setup page that creates the instance admin. Further accounts sign up with an email
#   that a space admin has invited, unless open sign-up is enabled.
# clerk: delegate sign-in to Clerk (see the Clerk block below).
# PONA_FLOW_AUTH_MODE=local
# PONA_FLOW_ALLOW_OPEN_SIGNUP=0
# When open sign-up (or invite sign-up) should also grant can_create_spaces (public demo).
# PONA_FLOW_SIGNUP_CAN_CREATE_SPACES=0
# PONA_FLOW_SESSION_DAYS=30

# --- Credential store backend (Credentials tab) ------------------------------------
#   local        -> read/write <data dir>/.env; values entered in the UI persist there.
#                   Default in the container image; convenient for single-host installs.
#   passthrough  -> read-only os.environ; register slots in the UI and inject values via
#                   your platform's secret store (recommended when you have one).
#   hosted       -> reserved.
# Workflows reference a credential as $secret.<NAME>; the value is resolved at request
# time and never persisted in the catalog or logged.
PONA_FLOW_CREDENTIAL_BACKEND=local

# --- Outbound HTTP safety for sequence endpoint steps (see Docs/DEPLOYMENT.md) ---
# Endpoint steps refuse private / loopback / link-local targets by default.
# Optional comma-separated host allowlist; listed hosts may be private (e.g. a local
# LLM server on 127.0.0.1). Do not allowlist Ollama's :11434.
# PONA_FLOW_OUTBOUND_ALLOWLIST=hooks.example.com,api.example.com
# Set to 1 ONLY on a trusted private network to permit every private/loopback target.
# PONA_FLOW_ALLOW_PRIVATE_OUTBOUND=0

# --- MCP gateway Host validation -------------------------------------------------
# Derived from PONA_FLOW_PUBLIC_URL when unset. Comma-separated; "host:*" allows any port.
# PONA_FLOW_MCP_ALLOWED_HOSTS=flow.example.com,127.0.0.1:*

# --- Local vector search (see README.md § Vector search) ---------------------
# Semantic find over INSTANCE records, embedded by a local Ollama. Per-space settings in
# the space's Embeddings tab override these.
# PONA_FLOW_OLLAMA_URL=http://127.0.0.1:11434
# Must be an embedding model you have pulled (`ollama pull nomic-embed-text`); its vector
# width is baked into the Neo4j index, so there is no default.
# PONA_FLOW_OLLAMA_EMBED_MODEL=nomic-embed-text
# Non-loopback Ollama hosts a space manager may point at (comma-separated).
# PONA_FLOW_OLLAMA_ALLOWED_HOSTS=ollama.internal
# Seconds between re-embed sweeps of changed records; 0 disables (default 300).
# PONA_FLOW_EMBEDDING_REINDEX_SECONDS=300

# --- In-app updates (Fly self-host) ----------------------------------------------
# Baked in at image build (do not set by hand on Fly). Instance settings compares
# this SHA to GitHub main.
# PONA_FLOW_BUILD_SHA=
# PONA_FLOW_GITHUB_REPO=MitchMcQuinn/pona-flow
# PONA_FLOW_IMAGE=ghcr.io/mitchmcquinn/pona-flow:main
# Optional: raise GitHub API rate limits for the changelog.
# PONA_FLOW_GITHUB_TOKEN=
# Fly Machines deploy (set during scripts/fly-setup.sh, or later in Instance settings).
# FLY_APP_NAME=my-pona-flow
# FLY_API_TOKEN=

# --- Logging / diagnostics --------------------------------------------------------
# PONA_FLOW_LOG_LEVEL=INFO
# Echo raw exception text in 500 responses (local development only; the default returns
# a generic message and writes the detail to the server log).
# PONA_FLOW_DEBUG_ERRORS=0

# ---------------------------------------------------------------------------
# Clerk mode (only when PONA_FLOW_AUTH_MODE=clerk)
# ---------------------------------------------------------------------------
# Issuer = the Clerk "Frontend API URL" (API Keys page). The JWKS URL is derived from it.
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# Publishable key served to the browser by /api/auth/status.
# CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Backend API key: lets the server resolve member emails/names. Required for Cypress.
# CLERK_SECRET_KEY=sk_test_xxx
# Optional: restrict accepted tokens to these authorized parties (azp), comma-separated.
# CLERK_AUTHORIZED_PARTIES=https://app.example.com,http://127.0.0.1:5273
# Clock-skew tolerance in seconds when verifying session JWTs (default 60).
# CLERK_JWT_LEEWAY_SECONDS=60
# Grant instance admin to a specific identity (in local mode the setup page does this;
# in Clerk mode the first sign-in on an empty instance does, and these override it).
# SUPERADMIN_EMAIL=you@example.com
# SUPERADMIN_CLERK_ID=user_xxx

# ---------------------------------------------------------------------------
# Development-only switches. Both grant admin access without credentials, so the
# server refuses to start with either set unless it is bound to 127.0.0.1.
# ---------------------------------------------------------------------------
# Skip sign-in entirely and act as a synthetic admin on every request.
# PONA_FLOW_DISABLE_AUTH=1
# PONA_FLOW_DEV_USER_EMAIL=dev@localhost
# Unlock the raw catalog editor (App/data-db-editor.html) with an X-Dev-DB-Token header.
# DEV_DB_EDITOR_TOKEN=some-random-string
