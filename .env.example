# ---------------------------------------------------------------------------
# pona flow environment configuration
#
# Local development only. In production, these values are injected by the hosting
# platform's secret store / environment, not a committed .env file (see
# Docs/DECISIONS.md D6 and Docs/DEPLOYMENT.md).
# ---------------------------------------------------------------------------

# --- Neo4j (Neo4j Desktop — use the password you set when creating the local DB) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# --- SQLite — path relative to project root (or use an absolute path) ---
SQLITE_DATABASE_PATH=data.db

# Form bridge: .env key name whose value is the SQLite file containing the spaces table
# (bootstrap catalog only; per-space DBs use each row's sqlite_database_path_key)
PONA_FLOW_CATALOG_SQLITE_KEY=SQLITE_DATABASE_PATH

# --- Local auth bypass (development only!) ------------------------------------
# Skip Clerk entirely so you can run the app locally without a Clerk account.
# This grants a synthetic superadmin principal on EVERY /api/* request — never set it
# in a deployed/shared environment. Two flags are needed (backend + frontend):
#   1) Backend (this file): PONA_FLOW_DISABLE_AUTH=1
#   2) Frontend (App/ui/.env): VITE_DISABLE_AUTH=true
# Optional: email used for the synthetic local user (defaults to dev@localhost).
# PONA_FLOW_DISABLE_AUTH=1
# PONA_FLOW_DEV_USER_EMAIL=dev@localhost

# --- Authentication (Clerk) ---------------------------------------------------
# The backend verifies Clerk session JWTs against Clerk's JWKS. Provide EITHER the
# issuer (preferred; JWKS URL is derived) OR the explicit JWKS URL. Find the issuer
# in the Clerk dashboard under API Keys / "Frontend API URL" (e.g.
# https://your-app.clerk.accounts.dev).
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# Optional: grant the E2E test user instance-admin immediately after dev_reset wipes SQLite.
# Use the same email as CLERK_TEST_IDENTIFIER in App/ui/cypress.env.json.
# SUPERADMIN_EMAIL=e2e-test@example.com

# Optional: restrict accepted tokens to specific authorized parties (comma-separated
# origins). Only needed if you set this variable — when unset, all azp values are allowed.
# If you do use it for production domains, include the Vite dev server for Cypress:
# CLERK_AUTHORIZED_PARTIES=https://app.example.com,http://127.0.0.1:5173
# Optional: seconds of clock-skew tolerance when verifying session JWTs (default 60).
# Increase only if the host clock drifts; prefer syncing system time instead.
# CLERK_JWT_LEEWAY_SECONDS=60

# The React app (Vite) needs the Clerk publishable key at build/dev time. Set this in
# App/ui/.env (or the shell) so import.meta.env.VITE_CLERK_PUBLISHABLE_KEY is defined.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Cypress E2E: use `cd App/ui && npm run dev:e2e` (loads .env.e2e) so Clerk stays on
# localhost. Plain `npm run dev` redirects to the hosted Account Portal and breaks Cypress.

# Clerk secret key — required for Cypress E2E tests (@clerk/testing). Never commit the
# real value; set it only in your local .env. Create a dedicated test user in Clerk with
# password sign-in enabled, then copy App/ui/cypress.env.example → cypress.env.json.
# CLERK_SECRET_KEY=sk_test_xxx

# Optional: grant the E2E test user instance-admin immediately after dev_reset wipes SQLite.
# Use the same email as CLERK_TEST_IDENTIFIER in App/ui/cypress.env.json.
# SUPERADMIN_EMAIL=e2e-test@example.com

# --- Outbound HTTP safety for sequence endpoint steps (see Docs/DECISIONS.md D7) ---
# Optional comma-separated host allowlist; if set, endpoint steps may only call these hosts.
# PONA_FLOW_OUTBOUND_ALLOWLIST=hooks.example.com,api.example.com
# Set to 1 ONLY for trusted self-hosted targets to permit private/loopback addresses.
# PONA_FLOW_ALLOW_PRIVATE_OUTBOUND=0

# --- Credential store backend (see Docs/DECISIONS.md D6) ----------------------
# Where space-scoped credentials (Credentials tab) keep their secret VALUES. Metadata
# always lives in the catalog space_credentials table; only the value backend changes.
#   passthrough (default) -> read-only os.environ; register slots, inject values via the
#                            platform. Never writes a file.
#   local                 -> read/write THIS .env file (local development only).
#   hosted                -> reserved for a future provider adapter (read-only for now).
# PONA_FLOW_CREDENTIAL_BACKEND=passthrough

# --- Local vector search (see Docs/VECTORIZATION-VISION.md) -------------------
# Semantic find over INSTANCE records, embedded by a local Ollama. Per-space settings in
# the space's Embeddings tab override these; a space that never saved settings inherits
# them, so naming a model here enables vector search instance-wide.
# The engine calls this URL itself (a trusted localhost client), so it is restricted to loopback
# unless a host is explicitly allowlisted — it is not a per-space SSRF hole.
# PONA_FLOW_OLLAMA_URL=http://127.0.0.1:11434
# No default: the model's vector width is baked into the Neo4j index, so it must be an
# embedding model you have pulled (`ollama pull nomic-embed-text`).
# PONA_FLOW_OLLAMA_EMBED_MODEL=nomic-embed-text
# Non-loopback hosts a space manager may point at (comma-separated). Empty by default.
# PONA_FLOW_OLLAMA_ALLOWED_HOSTS=ollama.internal
# How often the engine re-embeds records changed since their last embed. 0 turns the
# periodic sweep off, leaving the Reindex button as the only trigger (default 300).
# PONA_FLOW_EMBEDDING_REINDEX_SECONDS=300

# --- Bind address (optional; Cloudflare/Reverse proxy fronts this in production) ---
# FORM_BRIDGE_HOST=127.0.0.1
# FORM_BRIDGE_PORT=8765
