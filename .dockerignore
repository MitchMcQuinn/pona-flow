# Build context for the Dockerfile. Keep it to what the two stages actually COPY.
*
!requirements.txt
!Engine/
!tools/reset_password.py
!App/assets/
!App/ui/
!App/composer/
!App/authoring/
!App/connector/
!App/regex-validator/
!control_plane/
!control_plane/**
!Docs/
Docs/**
!Docs/WHY-PONA-FLOW.md
!Docs/PITCH.md
!Docs/GETTING-STARTED.md

# Never ship local state, dependencies, build output, or secrets.
**/node_modules
**/dist
**/__pycache__
**/*.py[cod]
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.sqlite*
App/ui/cypress/videos
App/ui/cypress/screenshots
App/ui/cypress/downloads
App/ui/cypress.env.json
