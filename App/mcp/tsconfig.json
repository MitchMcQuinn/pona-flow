{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "@pona-flow/authoring": ["../authoring/src/index.ts"],
      "@pona-flow/composer": ["../composer/src/index.ts"],
      "@pona-flow/connector": ["../connector/src/index.ts"],
      "@pona-flow/regex-validator": ["../regex-validator/src/index.ts"]
    }
  },
  "include": ["src"]
}
