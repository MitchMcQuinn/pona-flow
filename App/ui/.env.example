# App/ui/.env — Vite dev-server variables (not committed; copy this file to .env).
#
# Since the built-in auth release the UI discovers its auth mode at runtime from
# GET /api/auth/status, so a normal local or Docker setup needs NOTHING here.
# The variables below are only for the Clerk mode and for Cypress.

# --- Clerk mode (optional) ----------------------------------------------------
# When the backend runs with PONA_FLOW_AUTH_MODE=clerk the publishable key is served by
# /api/auth/status (from CLERK_PUBLISHABLE_KEY in the project .env). Setting it here as
# well lets `npm run dev` work before the API is reachable.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- Cypress E2E --------------------------------------------------------------
# `npm run dev:e2e` loads .env.e2e instead; see App/ui/cypress/README.md.
