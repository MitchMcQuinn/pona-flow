{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@pona-flow/composer": ["../composer/src/index.ts"],
      "@pona-flow/composer/*": ["../composer/src/*"],
      "@pona-flow/regex-validator": ["../regex-validator/src/index.ts"],
      "@pona-flow/connector": ["../connector/src/index.ts"],
      "@pona-flow/authoring": ["../authoring/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
