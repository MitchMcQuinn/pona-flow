# pona flow — Docker Compose configuration.   cp .env.docker.example .env
#
# Only NEO4J_PASSWORD is required. Everything else has a working default for a
# single-machine install reachable at http://localhost:8765.

# --- Required ---------------------------------------------------------------------
# Password for the bundled Neo4j (minimum 8 characters). If you point NEO4J_URI at your
# own database below, use that database's password here instead.
NEO4J_PASSWORD=change-me-please

# --- Which services run -------------------------------------------------------------
# neo4j  -> bundled Neo4j Community. Remove it to use an external database.
# https  -> add Caddy with automatic TLS (set PONA_FLOW_DOMAIN and PONA_FLOW_PUBLIC_URL).
COMPOSE_PROFILES=neo4j

# --- Neo4j connection (defaults target the bundled service) -----------------------
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# External examples:
#   NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io        (Aura)
#   NEO4J_URI=bolt://host.docker.internal:7687          (Neo4j Desktop on the same machine)

# --- Where the app is reachable -----------------------------------------------------
# Host port and bind address for the app. Keep 127.0.0.1 when a reverse proxy sits in
# front; set PONA_FLOW_BIND=0.0.0.0 only to expose the plain-HTTP port on a trusted LAN.
# PONA_FLOW_PORT=8765
# PONA_FLOW_BIND=127.0.0.1
# Public URL browsers use (enables Secure cookies + MCP Host checks). Required when the
# app is reached through a domain name.
# PONA_FLOW_PUBLIC_URL=https://flow.example.com
# Domain for the https profile (Caddy). DNS must already point at this machine.
# PONA_FLOW_DOMAIN=flow.example.com

# --- Accounts -----------------------------------------------------------------------
# The first visit shows a setup page that creates the admin. Later accounts need an
# invitation from a space admin unless open sign-up is enabled.
# PONA_FLOW_ALLOW_OPEN_SIGNUP=0
# PONA_FLOW_SESSION_DAYS=30

# --- Image / resources ------------------------------------------------------------------
# PONA_FLOW_VERSION=latest
# NEO4J_HEAP=512m
# NEO4J_PAGECACHE=256m
# NEO4J_BROWSER_PORT=7474
# NEO4J_BOLT_PORT=7687

# --- Optional features (see .env.example for the full reference) -------------------
# PONA_FLOW_OUTBOUND_ALLOWLIST=hooks.example.com
# PONA_FLOW_OLLAMA_URL=http://host.docker.internal:11434
# PONA_FLOW_OLLAMA_EMBED_MODEL=nomic-embed-text
# PONA_FLOW_LOG_LEVEL=INFO
